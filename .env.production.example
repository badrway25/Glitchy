# ============================================================================
# PRODUCTION environment template — copy to .env on the production host.
# NEVER commit the real .env. Fill every value; no placeholders may remain.
# Run: bash scripts/prodlike_check.sh && bash scripts/credential_readiness_check.sh --staging
# ============================================================================

# ===========================================================================
# greatkart — STAGING environment template. Copy to `.env` on the staging host
# and fill REAL values there. NEVER commit the real `.env`. Placeholders only here.
# ===========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=GENERATE_A_FRESH_64+_CHAR_RANDOM_STRING
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging.yourbrand.com
CSRF_TRUSTED_ORIGINS=https://staging.yourbrand.com
DJANGO_LOG_LEVEL=INFO
SITE_NAME=Glitchy
SITE_TAGLINE=Premium fashion, printed on demand
SITE_BASE_URL=https://staging.yourbrand.com

# ---- Database (managed Postgres on staging) ----
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DB_CONN_MAX_AGE=60

# ---- HTTPS hardening (auto-applied when DJANGO_DEBUG=False) ----
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ---- Email (SMTP is FALLBACK only; n8n is primary) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=staging-no-reply@yourbrand.com
EMAIL_HOST_PASSWORD=PROVIDER_APP_PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=staging-no-reply@yourbrand.com
SUPPORT_EMAIL=support@yourbrand.com
ADMIN_NOTIFY_EMAIL=ops@yourbrand.com
EMAIL_SMTP_FALLBACK=True

# ---- Printify (NEVER push real orders in staging) ----
PRINTIFY_API_TOKEN=STAGING_PRINTIFY_TOKEN
PRINTIFY_SHOP_ID=0000000
PRINTIFY_PUSH_ENABLED=False   # keep False until you intend to send real orders
SHIPPING_USE_PRINTIFY=False

# ---- Stripe (TEST keys for staging) ----
STRIPE_PUBLIC_KEY=pk_live_YOUR_LIVE_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_FROM_THE_REGISTERED_PRODUCTION_WEBHOOK
STRIPE_CURRENCY=eur
PAYMENT_FEE_PERCENT=1.5
PAYMENT_FEE_FIXED=0.25

# ---- PayPal (public client id) ----
PAYPAL_CLIENT_ID=STAGING_PAYPAL_CLIENT_ID
PAYPAL_CURRENCY=EUR

# ---- Store economics ----
STORE_TAX_RATE=2.0
STORE_CURRENCY=EUR
STORE_CURRENCY_SYMBOL=€

# ---- Shipping ----
SHIPPING_DEFAULT_COUNTRY=IT
SHIPPING_FREE_THRESHOLD=80
SHIPPING_SUPPORTED_COUNTRIES=

# ---- Returns ----
RETURN_WINDOW_DAYS=14

# ---- n8n (primary email/automation channel) ----
N8N_ENABLED=True
N8N_WEBHOOK_BASE_URL=https://n8n-staging.yourbrand.com/webhook
# PRIMARY enforcement — must match the n8n "Glitchy n8n Header Auth" credential value
N8N_HEADER_AUTH_NAME=X-N8N-AUTH
N8N_HEADER_AUTH_SECRET=GENERATE_A_FRESH_RANDOM_STRING_DISTINCT_FROM_SHARED_SECRET
# Observability signature — distinct from the header auth secret
N8N_SHARED_SECRET=GENERATE_A_DIFFERENT_FRESH_RANDOM_STRING
N8N_TIMEOUT=15
N8N_MAX_RETRIES=3

# --- Contextual AI assistant ---
AI_ASSISTANT_ENABLED=True
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=YOUR_ROTATED_OPENAI_KEY
# Staging/prod gate: set to True ONLY after revoking the exposed key and creating a new one.
OPENAI_KEY_ROTATED=True   # only after revoking the exposed key
AI_MAX_TOKENS=500
AI_TIMEOUT_SECONDS=20
AI_RATE_LIMIT=20
AI_CONTEXT_ONLY=True

# --- Added in later phases ---
SITE_URL=https://shop.example.com          # canonical origin (sitemap/canonical/OG)
PAYPAL_SECRET=                              # required to VERIFY PayPal (else PayPal stays disabled)
PAYPAL_API_BASE=https://api-m.paypal.com    # sandbox: https://api-m.sandbox.paypal.com
PAYPAL_ENABLED=False                        # only True when client id + secret are set
N8N_ENABLED=True
N8N_WEBHOOK_BASE_URL=https://n8n.example.com/webhook
N8N_HEADER_AUTH_NAME=X-N8N-AUTH
N8N_HEADER_AUTH_SECRET=                     # set a long random value; never commit
N8N_SHARED_SECRET=                          # HMAC secret for inbound n8n callbacks
