# OPTIONAL logrotate config — only needed if you log to FILES.
# By default gunicorn logs to stdout/stderr -> journald (rotated by systemd),
# and nginx logs are rotated by the distro's /etc/logrotate.d/nginx.
# Use this only if you redirect app logs to files under __LOG_DIR__.
#
# Install: /etc/logrotate.d/greatkart-staging

__LOG_DIR__/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su __APP_USER__ __APP_GROUP__
}
