# OPTIONAL: socket-activated gunicorn (unix socket instead of TCP).
# Install to /etc/systemd/system/greatkart-staging.socket. Use together with a
# service whose ExecStart binds `--bind unix:/run/greatkart-staging.sock`.

[Unit]
Description=greatkart staging gunicorn socket

[Socket]
ListenStream=/run/greatkart-staging.sock
SocketUser=__APP_USER__
SocketGroup=www-data
SocketMode=0660

[Install]
WantedBy=sockets.target

# Then nginx upstream:  proxy_pass http://unix:/run/greatkart-staging.sock;
# Commands:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now greatkart-staging.socket
