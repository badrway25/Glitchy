# The canonical staging env template is /.env.staging.example (repo root).
# On the staging host:
#   cp .env.staging.example .env
#   chmod 600 .env && chown __APP_USER__ .env
#   # fill in REAL values; NEVER commit .env
#
# This file is a pointer only — keep a single source of truth to avoid drift.
# Required keys (placeholders documented in /.env.staging.example):
#   DJANGO_SECRET_KEY, DJANGO_DEBUG=False, DJANGO_ALLOWED_HOSTS,
#   CSRF_TRUSTED_ORIGINS, DATABASE_URL, SITE_BASE_URL,
#   STRIPE_PUBLIC_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#   PRINTIFY_API_TOKEN, PRINTIFY_SHOP_ID, PRINTIFY_PUSH_ENABLED=False,
#   SHIPPING_USE_PRINTIFY,
#   N8N_ENABLED=True, N8N_WEBHOOK_BASE_URL, N8N_HEADER_AUTH_SECRET, N8N_SHARED_SECRET,
#   EMAIL_* (SMTP fallback only), ADMIN_NOTIFY_EMAIL, SUPPORT_EMAIL,
#   SECURE_SSL_REDIRECT, SECURE_HSTS_SECONDS
