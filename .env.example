# ===========================================================================
# greatkart — environment template. Copy to `.env` and fill in real values.
# NEVER commit the real `.env`.
# ===========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma list of https origins for CSRF behind a domain, e.g. https://shop.example.com
CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
# Production DB (leave empty for SQLite). e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# ---- Brand ----
SITE_NAME=MAISON
SITE_TAGLINE=Premium fashion, printed on demand
SITE_BASE_URL=http://127.0.0.1:8000

# ---- Email (SMTP fallback; primary channel is n8n) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-address@gmail.com
SUPPORT_EMAIL=support@yourbrand.com
ADMIN_NOTIFY_EMAIL=ops@yourbrand.com
EMAIL_SMTP_FALLBACK=True

# ---- Printify ----
PRINTIFY_API_TOKEN=your-printify-api-token
PRINTIFY_SHOP_ID=0000000
# Set False to avoid creating real Printify orders (dry-runs/staging)
PRINTIFY_PUSH_ENABLED=True

# ---- Stripe ----
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=eur
PAYMENT_FEE_PERCENT=1.5
PAYMENT_FEE_FIXED=0.25

# ---- PayPal (client id is public, used in browser) ----
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CURRENCY=EUR

# ---- Store economics ----
STORE_TAX_RATE=2.0
STORE_CURRENCY=EUR
STORE_CURRENCY_SYMBOL=€

# ---- Shipping ----
SHIPPING_DEFAULT_COUNTRY=IT
SHIPPING_FREE_THRESHOLD=80
# Comma list of ISO2 codes you ship to (empty = ship anywhere)
SHIPPING_SUPPORTED_COUNTRIES=

# ---- Returns ----
RETURN_WINDOW_DAYS=14

# ---- n8n automation ----
N8N_ENABLED=False
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# Primary enforcement: n8n native Header Auth (create a matching credential in n8n)
N8N_HEADER_AUTH_NAME=X-N8N-AUTH
N8N_HEADER_AUTH_SECRET=change-me-to-a-long-random-string
# Optional application signature (observability / defense-in-depth)
N8N_SHARED_SECRET=change-me-to-a-long-random-string
N8N_TIMEOUT=15
N8N_MAX_RETRIES=3

# --- Contextual AI assistant (OpenAI) ---
# Generate a key at https://platform.openai.com/api-keys — never commit the real value.
AI_ASSISTANT_ENABLED=True
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# Staging/prod gate: set to True ONLY after revoking the exposed key and creating a new one.
OPENAI_KEY_ROTATED=False
PRINTIFY_KEY_ROTATED=False        # exposed token must be rotated before staging/prod
AI_MAX_TOKENS=500
AI_TIMEOUT_SECONDS=20
AI_RATE_LIMIT=20
AI_CONTEXT_ONLY=True
